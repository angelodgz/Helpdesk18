<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
    ════════════════════════════════════════════════════════════════════════
    MENU STRUCTURE
    ════════════════════════════════════════════════════════════════════════
    Helpdesk                    ← root app menu (all groups)
    ├── My Tickets              ← visible to all (Users, Agents, Managers)
    ├── All Tickets             ← visible to Agents and Managers
    ├── Waiting Approval        ← visible to Managers only
    └── Configuration           ← visible to Managers only
        ├── Stages
        └── Tags
    ════════════════════════════════════════════════════════════════════════
    -->

    <!-- ── Root application menu ──────────────────────────────────────── -->
    <menuitem id="menu_helpdesk_root"
              name="Helpdesk"
              web_icon="helpdesk_ticket,static/description/icon.png"
              sequence="70"
              groups="helpdesk_ticket.group_helpdesk_user"/>

    <!-- ── My Tickets (default for all users — opens Kanban) ───────────── -->
    <menuitem id="menu_helpdesk_my_tickets"
              name="My Tickets"
              parent="menu_helpdesk_root"
              action="action_helpdesk_my_tickets"
              sequence="10"
              groups="helpdesk_ticket.group_helpdesk_user"/>

    <!-- ── All Tickets (Agents and Managers) ─────────────────────────── -->
    <menuitem id="menu_helpdesk_all_tickets"
              name="All Tickets"
              parent="menu_helpdesk_root"
              action="action_helpdesk_ticket"
              sequence="20"
              groups="helpdesk_ticket.group_helpdesk_agent"/>

    <!-- ── Waiting Approval (Managers only) ─────────────────────────── -->
    <menuitem id="menu_helpdesk_waiting_approval"
              name="Waiting Approval"
              parent="menu_helpdesk_root"
              action="action_helpdesk_waiting_approval"
              sequence="30"
              groups="helpdesk_ticket.group_helpdesk_manager"/>

    <!-- ── Configuration submenu (Managers only) ─────────────────────── -->
    <menuitem id="menu_helpdesk_configuration"
              name="Configuration"
              parent="menu_helpdesk_root"
              sequence="90"
              groups="helpdesk_ticket.group_helpdesk_manager"/>

    <menuitem id="menu_helpdesk_stages"
              name="Stages"
              parent="menu_helpdesk_configuration"
              action="action_helpdesk_stage"
              sequence="10"
              groups="helpdesk_ticket.group_helpdesk_manager"/>

    <menuitem id="menu_helpdesk_tags"
              name="Tags"
              parent="menu_helpdesk_configuration"
              action="action_helpdesk_tag"
              sequence="20"
              groups="helpdesk_ticket.group_helpdesk_manager"/>

    <menuitem id="menu_helpdesk_teams"
              name="Support Teams"
              parent="menu_helpdesk_configuration"
              action="action_helpdesk_team"
              sequence="30"
              groups="helpdesk_ticket.group_helpdesk_manager"/>

</odoo>
