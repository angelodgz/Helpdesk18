<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_employee_helpdesk_inherit" model="ir.ui.view">
        <field name="name">hr.employee.helpdesk.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">

            <!-- Inject smart buttons into the existing button box -->
            <div name="button_box" position="inside">

                <!-- Smart Button 1: Tickets submitted by this employee -->
                <button class="oe_stat_button"
                        type="object"
                        name="action_open_submitted_tickets"
                        icon="fa-ticket"
                        groups="helpdesk_ticket.group_helpdesk_user">
                    <field name="submitted_ticket_count"
                           string="Submitted Tickets"
                           widget="statinfo"/>
                </button>

                <!-- Smart Button 2 (Bonus): Tickets assigned to this employee -->
                <button class="oe_stat_button"
                        type="object"
                        name="action_open_assigned_tickets"
                        icon="fa-headphones"
                        groups="helpdesk_ticket.group_helpdesk_agent"
                        invisible="not user_id">
                    <field name="assigned_ticket_count"
                           string="Assigned Tickets"
                           widget="statinfo"/>
                </button>

            </div>

        </field>
    </record>

</odoo>
