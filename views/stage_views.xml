<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!--  STAGE FORM VIEW                                                   -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_helpdesk_stage_form" model="ir.ui.view">
        <field name="name">helpdesk.ticket.stage.form</field>
        <field name="model">helpdesk.ticket.stage</field>
        <field name="arch" type="xml">
            <form string="Stage">
                <sheet>
                    <!-- Colored ribbons for terminal stages -->
                    <widget name="web_ribbon"
                            title="Done Stage"
                            bg_color="bg-success"
                            invisible="not is_done_stage"/>
                    <widget name="web_ribbon"
                            title="Cancelled Stage"
                            bg_color="bg-danger"
                            invisible="not is_cancelled_stage"/>

                    <group>
                        <group string="Stage Details">
                            <field name="name" placeholder="e.g. In Progress"/>
                            <field name="sequence"/>
                            <field name="fold"/>
                        </group>
                        <group string="Stage Type">
                            <field name="is_done_stage"/>
                            <field name="is_cancelled_stage"/>
                        </group>
                    </group>
                    <group string="Internal Notes">
                        <field name="description" nolabel="1" placeholder="Internal description of this stage..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!--  STAGE LIST VIEW                                                   -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_helpdesk_stage_list" model="ir.ui.view">
        <field name="name">helpdesk.ticket.stage.list</field>
        <field name="model">helpdesk.ticket.stage</field>
        <field name="arch" type="xml">
            <list string="Stages" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="is_done_stage"/>
                <field name="is_cancelled_stage"/>
                <field name="fold"/>
                <field name="ticket_count" string="Tickets"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!--  STAGE ACTION                                                      -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <record id="action_helpdesk_stage" model="ir.actions.act_window">
        <field name="name">Stages</field>
        <field name="res_model">helpdesk.ticket.stage</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!--  TAG FORM VIEW                                                     -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_helpdesk_tag_form" model="ir.ui.view">
        <field name="name">helpdesk.tag.form</field>
        <field name="model">helpdesk.tag</field>
        <field name="arch" type="xml">
            <form string="Tag">
                <sheet>
                    <group>
                        <field name="name" placeholder="Tag label"/>
                        <field name="color" widget="color_picker"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!--  TAG LIST VIEW                                                     -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_helpdesk_tag_list" model="ir.ui.view">
        <field name="name">helpdesk.tag.list</field>
        <field name="model">helpdesk.tag</field>
        <field name="arch" type="xml">
            <list string="Tags" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!--  TAG ACTION                                                        -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <record id="action_helpdesk_tag" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">helpdesk.tag</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!--  TEAM FORM VIEW                                                    -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_helpdesk_team_form" model="ir.ui.view">
        <field name="name">helpdesk.team.form</field>
        <field name="model">helpdesk.team</field>
        <field name="arch" type="xml">
            <form string="Support Team">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Team Name"/></h1>
                    </div>
                    <group>
                        <group string="Team Details">
                            <field name="active"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                    </group>
                    <group string="Members">
                        <field name="member_ids"
                               widget="many2many_tags"
                               options="{'no_create': True}"
                               nolabel="1"/>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" placeholder="Team description..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!--  TEAM LIST VIEW                                                    -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_helpdesk_team_list" model="ir.ui.view">
        <field name="name">helpdesk.team.list</field>
        <field name="model">helpdesk.team</field>
        <field name="arch" type="xml">
            <list string="Support Teams" editable="bottom">
                <field name="name"/>
                <field name="member_ids" widget="many2many_tags" options="{'no_create': True}"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!--  TEAM ACTION                                                       -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <record id="action_helpdesk_team" model="ir.actions.act_window">
        <field name="name">Support Teams</field>
        <field name="res_model">helpdesk.team</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
